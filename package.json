{
  "name": "perch",
  "productName": "Perch",
  "version": "0.1.0",
  "description": "A temporary screenshot shelf for Windows",
  "main": "./out/main/index.js",
  "author": "Dániel K",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm test && electron-vite build && electron-builder --win --publish never",
    "icons": "electron scripts/make-icons.cjs",
    "build:dir": "electron-vite build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/dan0dev/perch",
  "repository": {
    "type": "git",
    "url": "https://github.com/dan0dev/perch.git"
  },
  "bugs": {
    "url": "https://github.com/dan0dev/perch/issues"
  }
}
